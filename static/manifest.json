{
  "manifest_version": 3,
  "name": "Rell Syntax Highlighting",
  "version": "0.4.0",
  "description": "Syntax highlighting for Rell (.rell) files, diffs, and ```rell code blocks on github.com, gitlab.com, and bitbucket.org.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://gitlab.com/*",
        "https://bitbucket.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://bitbucket.org/*"],
      "js": ["monaco.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
